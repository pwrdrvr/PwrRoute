# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out/
build/
*.tsbuildinfo
# A stray bundle at the workspace root: this repo has no root entry point, so
# an index.js here is always something a build wrote by accident.
/index.js

# electron-builder buildResources (entitlements, icons) are source, not output —
# carve them out of the blanket build/ ignore above.
!apps/desktop/build/

# Electron packaging / distributables
apps/desktop/release/
*.app
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
*.snap

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
playwright-report/
test-results/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/

# Environment
.env
.env.local
.env.*.local

# Claude Design exports (redundant with the extracted source under design/)
design/*.zip
design/**/.thumbnail
# Design-session chat transcripts and pasted reference screenshots. Neither is
# referenced by an artboard, and both can carry private context. Matches
# PwrGit and PwrAgnt; see design/SOURCE.md.
design/chats/
design/uploads/

# Local task artifacts and PR descriptions
.local/

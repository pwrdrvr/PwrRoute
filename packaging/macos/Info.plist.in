<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by `cargo xtask bundle`, which fills in @SHORT_VERSION@: the version without any
     prerelease suffix, because macOS wants three numbers here.
     CFBundleURLTypes declares http and https, which is what lets macOS offer
     PwrRoute as a default browser; the router receives them as kAEGetURL
     Apple Events. Becoming the default is still an explicit action in the
     app, answered by the OS consent prompt.
     The icon is two files from one source, as Xcode writes them: `cargo xtask
     bundle` compiles packaging/icon/PwrRoute.icon with actool into
     Contents/Resources/Assets.car, which CFBundleIconName names and macOS 26
     draws, and Icon.icns, which CFBundleIconFile names for older macOS. Without
     Xcode 26 the bundle task drops CFBundleIconName and copies the legacy
     packaging/macos/PwrRoute.icns in as Icon.icns instead. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.pwrdrvr.pwrroute</string>
	<key>CFBundleName</key>
	<string>PwrRoute</string>
	<key>CFBundleDisplayName</key>
	<string>PwrRoute</string>
	<key>CFBundleExecutable</key>
	<string>pwrroute</string>
	<key>CFBundleIconFile</key>
	<string>Icon</string>
	<key>CFBundleIconName</key>
	<string>Icon</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>Web site URL</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@SHORT_VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 PwrDrvr LLC.</string>
</dict>
</plist>

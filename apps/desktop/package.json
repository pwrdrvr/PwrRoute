{
  "name": "@pwrroute/desktop",
  "productName": "PwrRoute",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Default-browser router: every link to the right browser and profile",
  "homepage": "https://github.com/pwrdrvr/PwrRoute",
  "author": "PwrDrvr LLC",
  "license": "MIT",
  "copyright": "Copyright © 2026 PwrDrvr LLC",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:mac": "electron-vite build && node ./scripts/package.mjs --mac",
    "package:win": "electron-vite build && node ./scripts/package.mjs --win",
    "package:linux": "electron-vite build && node ./scripts/package.mjs --linux",
    "postinstall": "pnpm run install:electron-binary",
    "install:electron-binary": "node ./scripts/install-electron-binary.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@pwrroute/mcp-server": "workspace:*",
    "@pwrroute/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-builder": "26.17.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.5"
  }
}
